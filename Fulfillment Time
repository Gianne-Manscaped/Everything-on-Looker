iew: fulfillment_time {
    derived_table: {
      indexes: ["SalesOrderNumber"]
      sql:
      SELECT
      soh.period,
      soh.Shipping_Province As State,
      soh.Shipping_Country,
      t.warehouse,
      t.SalesOrderNumber,
      soh.Created_at As Ordered_Date,
      t.Delivery_Date,
      t.WMS_Imported_Date,
      t3.After_Cut_Off_Time,
      CASE WHEN t3.After_Cut_Off_Time =1 Then 'YES' Else 'NO' END AS After_Cut_Off_Time_YES_NO,
      t3.Weekday_WMS_Imported_Date,
      t.Fulfilled_Date,
      t3.Weekday_Fufilled_Date,
      DateDiff (hour,soh.Created_at,WMS_Imported_Date) AS Hold_Time,
      DateDiff(day,soh.Created_at, Delivery_Date) AS Days_From_Click_To_Delivery,
      DateDiff(day,soh.Created_at, Fulfilled_Date) AS Days_From_Click_To_FulFill,
      DateDiff(day,Fulfilled_Date, Delivery_Date) AS Days_In_Transit,
      DateDiff(day,WMS_Imported_Date, Fulfilled_Date) AS Days_From_3PL_Imported_Date_to_Fulfill,
      t3.Days_From_3PL_Imported_Date_To_Fulfill_Without_Weekend,
      CASE
      WHEN t3.After_Cut_Off_Time = 1 AND t3.Weekday_WMS_Imported_Date ='Monday' Then greatest((t3.Days_From_3PL_Imported_Date_To_Fulfill_Without_Weekend-1),0)
      WHEN t3.After_Cut_Off_Time = 1 AND t3.Weekday_WMS_Imported_Date ='Tuesday' Then greatest((t3.Days_From_3PL_Imported_Date_To_Fulfill_Without_Weekend-1),0)
      WHEN t3.After_Cut_Off_Time = 1 AND t3.Weekday_WMS_Imported_Date ='Wednesday' Then greatest((t3.Days_From_3PL_Imported_Date_To_Fulfill_Without_Weekend-1),0)
      WHEN t3.After_Cut_Off_Time = 1 AND t3.Weekday_WMS_Imported_Date ='Thursday' Then greatest((t3.Days_From_3PL_Imported_Date_To_Fulfill_Without_Weekend-1),0)
      WHEN t3.After_Cut_Off_Time = 1 AND t3.Weekday_WMS_Imported_Date ='Friday' Then greatest((t3.Days_From_3PL_Imported_Date_To_Fulfill_Without_Weekend-1),0)
      WHEN t3.Weekday_WMS_Imported_Date ='Saturday' Then greatest(t3.Days_From_3PL_Imported_Date_To_Fulfill_Without_Weekend,0)
      WHEN t3.Weekday_WMS_Imported_Date ='Sunday' Then greatest(t3.Days_From_3PL_Imported_Date_To_Fulfill_Without_Weekend-1,0)
      ELSE t3.Days_From_3PL_Imported_Date_To_Fulfill_Without_Weekend END AS Adjusted_Fulfillment_Time
      FROM ShopifyOrdersHeader soh
      INNER JOIN (SELECT s.Store,
          s.SalesOrderNumber ,
          sf.StatusDate as Delivery_Date,
          sf2.StatusDate as Fulfilled_Date,
          sf3.statusDate as WMS_Imported_Date,
          l.source3PL,
          CASE WHEN l.source3PL ='NPF' THEN 'NPF'
          WHEN l.Source3PL= 'Visible' And l.Locations ='ATL' Then 'Maersk-ATL'
          WHEN l.Source3PL= 'Visible' And l.Locations ='TOR' Then 'Maersk-TOR'
          WHEN l.Source3PL= 'Shiphero' And l.Locations LIKE'%Texas%' Then 'FSD-Reynosa'
          WHEN l.Source3PL= 'Shiphero' And l.Locations LIKE'%TX%' Then 'FSD-Reynosa'
          WHEN l.source3pl= 'Shiphero' And l.Locations LIKE'%Reynosa%' Then 'FSD-Reynosa'
          WHEN l.Source3PL= 'Shiphero' And l.Locations = 'Manscaped-DTC' Then 'FSD-Tecate'
          WHEN l.Source3PL= 'Shiphero' And l.Locations LIKE '%Tecate%' Then 'FSD-Tecate'
          WHEN l.Source3PL= 'Shiphero' And l.Locations LIKE '%Toronto%' Then 'FSD-Hamilton'
          WHEN l.Source3PL= 'Shiphero' And l.Locations LIKE '%BFS%' Then 'FSD-Hamilton'
          WHEN l.Source3PL= 'Shiphero' And l.Locations ='default' Then 'FSD-Tecate/FSD-Reynosa'
          WHEN l.Source3PL= 'SEKO' And l.Locations ='DCCL01' Then 'SEKO-UK'
          WHEN l.Source3PL= 'SEKO' And l.Locations ='DCRTDM02' Then 'SEKO-NL'
          WHEN l.Source3PL= 'Shiphero' And l.Locations ='Trade Place' Then 'Trade Place'
          WHEN l.Source3PL= 'TFI' Then 'TFI'
          Else coalesce (l.Source3PL,l.locations)
                  END AS Warehouse
          FROM SourceSystemDim ss
          INNER JOIN SalesOrderStatusDim sos2 ON sos2.Status = 'Fulfilled'
          INNER JOIN SalesOrderStatusFact sf2 ON ss.SourceSystemId = sf2.SourceSystemId AND sos2.SalesOrderStatusId = sf2.SalesOrderStatusId
          LEFT JOIN SalesOrderStatusDim sos ON sos.Status = 'Delivered'
          LEFT JOIN SalesOrderStatusFact sf ON sos.SalesOrderStatusId = sf.SalesOrderStatusId AND sf.SourceSystemId = sf2.SourceSystemId and sf.SalesOrderId = sf2.SalesOrderId
          LEFT JOIN SalesOrderStatusDim sos3 ON sos3.Status = 'Open'
          LEFT JOIN SalesOrderStatusFact sf3 ON sos3.SalesOrderStatusId = sf3.SalesOrderStatusId AND sf2.SourceSystemId = sf3.SourceSystemId and sf2.SalesOrderId = sf3.SalesOrderId
          INNER JOIN SalesOrderDim s ON sf2.SalesOrderId = s.SalesOrderId
          INNER JOIN LocationGroupDim l ON sf2.locationgroupid = l.locationgroupid
          WHERE sf2.statusdate >='2023-05-01') t On soh.OrderNumber = t.SalesOrderNumber
      INNER JOIN (
                  SELECT
              t.SalesOrderNumber,
              Datename(weekday,WMS_Imported_Date) As Weekday_WMS_Imported_Date,
              Datename(weekday,Fulfilled_Date) As Weekday_Fufilled_Date,
              CASE
              WHEN t.source3PL ='Shiphero' And CAST(t.WMS_Imported_Date AS TIME) >= '10:00:00' THEN 1
              WHEN t.source3PL ='Visible' And CAST(t.WMS_Imported_Date AS TIME) >= '12:00:00' THEN 1
              WHEN t.source3PL ='Flexport' And CAST(t.WMS_Imported_Date AS TIME) >= '14:00:00' THEN 1
              WHEN t.source3PL ='NP' And CAST(t.WMS_Imported_Date AS TIME) >= '05:20:00' THEN 1
              WHEN t.source3PL ='TFI' And CAST(t.WMS_Imported_Date AS TIME) >= '12:00:00' THEN 1
              Else 0 END AS After_Cut_Off_Time,
              CASE WHEN (DateDiff(day,WMS_Imported_Date, Fulfilled_Date) - DATEDIFF (week,WMS_Imported_Date,DateAdd(day, 1,Fulfilled_Date))- DATEDIFF(week,WMS_Imported_Date,Fulfilled_Date)) <0 Then '0' ElSE DateDiff(day,WMS_Imported_Date, Fulfilled_Date) - DATEDIFF (week,WMS_Imported_Date,DateAdd(day, 1,Fulfilled_Date))- DATEDIFF(week,WMS_Imported_Date,Fulfilled_Date) END AS Days_From_3PL_Imported_Date_To_Fulfill_Without_Weekend
              FROM (SELECT s.Store,
          s.SalesOrderNumber ,
          sf.StatusDate as Delivery_Date,
          sf2.StatusDate as Fulfilled_Date,
          sf3.statusDate as WMS_Imported_Date,
          l.source3PL,
          CASE WHEN l.source3PL ='NPF' THEN 'NPF'
                      WHEN l.Source3PL= 'Visible' And l.Locations ='ATL' Then 'Maersk-ATL'
                      WHEN l.Source3PL= 'Visible' And l.Locations ='TOR' Then 'Maersk-TOR'
                      WHEN l.Source3PL= 'Shiphero' And l.Locations ='Texas' Then 'FSD-Reynosa'
                      WHEN l.Source3PL= 'Shiphero' And l.Locations LIKE 'Manscaped-DTC%' Then 'FSD-Baja'
                      WHEN l.Source3PL= 'Shiphero' And l.Locations LIKE 'BFS-H%' Then 'FSD-Hamilton'
                      WHEN l.Source3PL= 'Shiphero' And l.Locations ='default' Then 'FSD-Baja/FSD-Reynosa'
                      WHEN l.Source3PL= 'SEKO' And l.Locations ='DCCL01' Then 'SEKO-UK'
                      WHEN l.Source3PL= 'SEKO' And l.Locations ='DCRTDM02' Then 'SEKO-NL'
                      WHEN l.Source3PL= 'Shiphero' And l.Locations ='Trade Place' Then 'Trade Place'
                      WHEN l.Source3PL= 'TFI' Then 'TFI'
          Else coalesce (l.Source3PL,l.locations)
                  END AS Warehouse
          FROM SourceSystemDim ss
          INNER JOIN SalesOrderStatusDim sos2 ON sos2.Status = 'Fulfilled'
          INNER JOIN SalesOrderStatusFact sf2 ON ss.SourceSystemId = sf2.SourceSystemId AND sos2.SalesOrderStatusId = sf2.SalesOrderStatusId
          LEFT JOIN SalesOrderStatusDim sos ON sos.Status = 'Delivered'
          LEFT JOIN SalesOrderStatusFact sf ON sos.SalesOrderStatusId = sf.SalesOrderStatusId AND sf.SourceSystemId = sf2.SourceSystemId and sf.SalesOrderId = sf2.SalesOrderId
          LEFT JOIN SalesOrderStatusDim sos3 ON sos3.Status = 'Open'
          LEFT JOIN SalesOrderStatusFact sf3 ON sos3.SalesOrderStatusId = sf3.SalesOrderStatusId AND sf2.SourceSystemId = sf3.SourceSystemId and sf2.SalesOrderId = sf3.SalesOrderId
          INNER JOIN SalesOrderDim s ON sf2.SalesOrderId = s.SalesOrderId
          INNER JOIN LocationGroupDim l ON sf2.locationgroupid = l.locationgroupid
          WHERE sf2.statusdate >='2023-05-01') t
              ) t3 ON t.SalesOrderNumber = t3.SalesOrderNumber

        Group By
        soh.period,
        t.warehouse,
        soh.Shipping_Province,
        soh.shipping_Country,
        t.SalesOrderNumber,
        soh.Created_at,
        t.Delivery_Date,
        t.WMS_Imported_Date,
        t3.After_Cut_Off_Time,
        CASE WHEN t3.After_Cut_Off_Time =1 Then 'YES' Else 'NO' END,
        t3.Weekday_WMS_Imported_Date,
        t.Fulfilled_Date,
        t3.Weekday_Fufilled_Date,
        DateDiff (hour,soh.Created_at,WMS_Imported_Date),
        DateDiff(day,soh.Created_at, Delivery_Date),
        DateDiff(day,soh.Created_at, Fulfilled_Date),
        DateDiff(day,Fulfilled_Date, Delivery_Date),
        DateDiff(day,WMS_Imported_Date, Fulfilled_Date),
        t3.Days_From_3PL_Imported_Date_To_Fulfill_Without_Weekend,
        CASE
        WHEN t3.After_Cut_Off_Time = 1 AND t3.Weekday_WMS_Imported_Date ='Monday' Then greatest((t3.Days_From_3PL_Imported_Date_To_Fulfill_Without_Weekend-1),0)
        WHEN t3.After_Cut_Off_Time = 1 AND t3.Weekday_WMS_Imported_Date ='Tuesday' Then greatest((t3.Days_From_3PL_Imported_Date_To_Fulfill_Without_Weekend-1),0)
        WHEN t3.After_Cut_Off_Time = 1 AND t3.Weekday_WMS_Imported_Date ='Wednesday' Then greatest((t3.Days_From_3PL_Imported_Date_To_Fulfill_Without_Weekend-1),0)
        WHEN t3.After_Cut_Off_Time = 1 AND t3.Weekday_WMS_Imported_Date ='Thursday' Then greatest((t3.Days_From_3PL_Imported_Date_To_Fulfill_Without_Weekend-1),0)
        WHEN t3.After_Cut_Off_Time = 1 AND t3.Weekday_WMS_Imported_Date ='Friday' Then greatest((t3.Days_From_3PL_Imported_Date_To_Fulfill_Without_Weekend-1),0)
        WHEN t3.Weekday_WMS_Imported_Date ='Saturday' Then greatest(t3.Days_From_3PL_Imported_Date_To_Fulfill_Without_Weekend,0)
        WHEN t3.Weekday_WMS_Imported_Date ='Sunday' Then greatest(t3.Days_From_3PL_Imported_Date_To_Fulfill_Without_Weekend-1,0)
        ELSE t3.Days_From_3PL_Imported_Date_To_Fulfill_Without_Weekend END


        ;;
      sql_trigger_value: SELECT DATEPART(hour, GETDATE()) ;;


    }


    ####dimension####

    dimension: period{
      type: string
      sql: ${TABLE}.period ;;
    }

    dimension: State {
      type: string
      sql: ${TABLE}.State ;;
    }
    dimension: Shipping_Country {
      type: string
      sql: ${TABLE}.Shipping_Country ;;
    }

    dimension: warehouse {
      type: string
      sql: ${TABLE}.warehouse ;;
    }

    dimension: SalesOrderNumber {
      primary_key: yes
      type: string
      sql: ${TABLE}.SalesOrderNumber ;;
    }

    dimension_group: Ordered_Date {
      type: time
      convert_tz: no
      timeframes: [raw, time, date, day_of_week, day_of_week_index, week, week_of_year, month, month_name, month_num, quarter, year]
      sql: ${TABLE}.Ordered_Date ;;
    }

    dimension_group: Fulfilled_Date {
      type: time
      convert_tz: no
      timeframes: [raw, time, time_of_day, date, day_of_week, day_of_week_index, week, week_of_year, month, month_name, month_num, quarter, year]
      sql: ${TABLE}.Fulfilled_Date ;;
    }

    dimension_group: Delivery_Date {
      type: time
      convert_tz: no
      timeframes: [raw, time, time_of_day, date, day_of_week, day_of_week_index, week, week_of_year, month, month_name, month_num, quarter, year]
      sql: ${TABLE}.Delivery_Date ;;
    }

    dimension_group: WMS_Imported_Date {
      type: time
      convert_tz: no
      timeframes: [raw, time,time_of_day,date, day_of_week, day_of_week_index, week, week_of_year, month, month_name, month_num, quarter, year]
      sql: ${TABLE}.WMS_Imported_Date ;;
    }


    dimension: After_Cut_Off_Time {
      hidden: yes
      type: string
      sql: ${TABLE}.After_Cut_Off_Time ;;
    }

    dimension: After_Cut_Off_Time_YES_NO {
      type: string
      sql: ${TABLE}.After_Cut_Off_Time_YES_NO ;;
    }

    dimension: Weekday_WMS_Imported_Date {
      type: string
      sql: ${TABLE}.Weekday_WMS_Imported_Date;;
    }

    dimension: Weekday_Fufilled_Date{
      type: string
      sql: ${TABLE}.Weekday_Fufilled_Date ;;
    }

    dimension: Hold_Time {
      type: number
      sql: ${TABLE}.Hold_Time ;;
    }


    dimension: Days_From_Click_To_Delivery {
      type: number
      sql: ${TABLE}.Days_From_Click_To_Delivery ;;
    }

    dimension: Days_From_Click_To_FulFill {
      type: number
      sql: ${TABLE}.Days_From_Click_To_FulFill;;
    }

    dimension: Days_In_Transit {
      type: number
      sql: ${TABLE}.Days_In_Transit ;;
    }

    dimension: Days_From_3PL_Imported_Date_to_Fulfill{
      hidden: yes
      type: number
      sql: ${TABLE}.Days_From_3PL_Imported_Date_to_Fulfill ;;
    }

    dimension: Days_From_3PL_Imported_Date_To_Fulfill_Without_Weekend {
      type: number
      hidden: yes
      sql: ${TABLE}.Days_From_3PL_Imported_Date_To_Fulfill_Without_Weekend ;;
    }

    dimension: Adjusted_Days_To_Fulfill{
      type: number
      sql: ${TABLE}.Adjusted_Fulfillment_Time ;;
    }

    measure: Avg_Hold_Time{
      type: average
      value_format_name: decimal_1
      label: "Avg Hold_Time"
      group_label: "Core CPI's"
      description: "Avg_Hold_Time"
      sql: ${Hold_Time};;
      }

      measure: Avg_Days_From_Click_To_Delivery{
        type: average
        value_format_name: decimal_1
        label: "Avg_Days_From_Click_To_Delivery "
        group_label: "Core CPI's"
        description: "Avg_Days_From_Click_To_Delivery"
        sql: ${Days_From_Click_To_Delivery};;
      }

      measure: Avg_Days_From_Click_To_FulFill{
        type: average
        value_format_name: decimal_1
        label: "Avg_Days_From_Click_To_FulFill"
        group_label: "Core CPI's"
        description: "Avg_Days_From_Click_To_FulFill"
        sql: ${Days_From_Click_To_FulFill};;
      }
      measure: Avg_Days_In_Transit{
        type: average
        value_format_name: decimal_1
        label: "Avg_Days_In_Transit "
        group_label: "Core CPI's"
        description: "Avg_Days_In_Transit"
        sql: ${Days_In_Transit};;
      }

      measure: Avg_Adjusted_Days_To_Fulfill{
        type: average
        value_format_name: decimal_1
        label: "Avg_Adjusted_Days_To_Fulfill"
        group_label: "Core CPI's"
        description: "Avg_Adjusted_Days_To_Fulfill"
        sql: ${Adjusted_Days_To_Fulfill};;
      }

      measure: Avg_Days_From_3PL_Imported_Date_to_Fulfill{
        type: average
        value_format_name: decimal_1
        label: "Avg_Days_From_3PL_Imported_Date_to_Fulfill"
        group_label: "Core CPI's"
        description: "Avg_Days_From_3PL_Imported_Date_to_Fulfill"
        sql: ${Days_From_3PL_Imported_Date_to_Fulfill};;
      }

      measure: Total_Hold_Time{
        type: average
        value_format_name: decimal_1
        label: "Total Hold_Time"
        group_label: "Core CPI's"
        description: "Total_Hold_Time"
        sql: ${Hold_Time};;
        }
        measure: Total_Days_From_Click_To_Delivery{
          type: sum
          value_format_name: decimal_1
          label: "Total_Days_From_Click_To_Delivery "
          group_label: "Core CPI's"
          description: "Total_Days_From_Click_To_Delivery"
          sql: ${Days_From_Click_To_Delivery};;
        }

        measure: Total_Days_From_Click_To_FulFill{
          type: sum
          value_format_name: decimal_1
          label: "Total_Days_From_Click_To_FulFill"
          group_label: "Core CPI's"
          description: "Total_Days_From_Click_To_FulFill"
          sql: ${Days_From_Click_To_FulFill};;
        }
        measure: Total_Days_In_Transit{
          type: sum
          value_format_name: decimal_1
          label: "Total_Days_In_Transit"
          group_label: "Core CPI's"
          description: "Total_Days_In_Transit"
          sql: ${Days_In_Transit};;
        }

        measure: Total_Adjusted_Fulfillment_Time{
          type: sum
          value_format_name: decimal_1
          label: "Total_Adjusted_Days_To_Fulfill"
          group_label: "Core CPI's"
          description: "Total_Adjusted_Days_To_Fulfill"
          sql: ${Adjusted_Days_To_Fulfill};;
        }

        measure: Total_Days_From_3PL_Imported_Date_to_Fulfill{
          type: sum
          value_format_name: decimal_1
          label: "Total_Days_From_3PL_Imported_Date_to_Fulfill"
          group_label: "Core CPI's"
          description: "Total_Days_From_3PL_Imported_Date_to_Fulfill"
          sql: ${Days_From_3PL_Imported_Date_to_Fulfill};;
        }
  }
