iew: order_category_dim {
  derived_table: {
  indexes: ["ordernumber"]
  sql:
  Select soh.ordernumber,
soh.tags,
soh.fulfillment_status,
soh.shipping_city,
soh.shipping_province,
soh.shipping_country,
soh.shipping_zip,
soh.created_at,
soh.fulfilled_at,
soh.closed_at,
soh.cancel_reason,
CASE WHEN UPPER(soh.tags) LIKE'%TNT%' Then 'Yes'
Else 'No' End AS 'Time_In_Transit_Testing',
CASE WHEN soh.TAGS LIKE 'CS-%' THEN 'CS ORDER'
WHEN soh.TAGS LIKE '%RECURRING%' THEN 'VIP'
WHEN soh.TAGS LIKE '%Subscription%' THEN 'VIP'
ELSE 'First-Time-Order or Off-Cycle'END AS 'Order_Category'
From ShopifyOrdersHeader soh
Where soh.created_at >='2023-05-01'
  ;;
  sql_trigger_value: SELECT DATEPART(day, GETDATE()) ;;
}

##### DIMENSIONS #####

dimension: Order_Number{
  primary_key: yes
  type: string
  sql: ${TABLE}.ordernumber;;
}

dimension: Order_Tags{
  type: string
  sql: ${TABLE}.tags;;
}

dimension: Fulfillment_Status{
  type: string
  sql: ${TABLE}.fulfillment_status;;
}
dimension: Shipping_City{
  type: string
  sql: ${TABLE}.shipping_city;;
}

dimension: Shipping_State{
  type: string
  sql: ${TABLE}.shipping_province;;
}

dimension: Shipping_Country{
  type: string
  sql: ${TABLE}.shipping_country;;
}

dimension: Shipping_Zip_Code{
  type: string
  sql: ${TABLE}.shipping_zip;;
}
dimension_group: Order_Fulfilled_Date {
  type: time
  convert_tz: no
  timeframes: [raw, time, date, day_of_week, day_of_week_index, week, week_of_year, month, month_name, month_num, quarter, year]
  sql: ${TABLE}.fulfilled_at ;;
}

dimension_group: Order_Create_Date {
  type: time
  convert_tz: no
  timeframes: [raw, time, date, day_of_week, day_of_week_index, week, week_of_year, month, month_name, month_num, quarter, year]
  sql: ${TABLE}.created_at ;;
}

dimension_group: Order_Closed_Date {
  type: time
  convert_tz: no
  timeframes: [raw, time, date, day_of_week, day_of_week_index, week, week_of_year, month, month_name, month_num, quarter, year]
  sql: ${TABLE}.closed_at ;;
}


dimension: cancel_reason{
  type: string
  sql: ${TABLE}.cancel_reason;;
}

  dimension: Order_Category{
    type: string
    sql: ${TABLE}.Order_Category;;
  }

dimension: Time_In_Transit_Testing{
  type: string
  sql: ${TABLE}.Time_In_Transit_Testing;;
}
}
