  WHEN ship.source3pl= 'Visible' And ship.warehouse='TOR' Then 'Maersk-TOR'
  WHEN ship.source3pl= 'Shiphero' And ship.warehouse LIKE'Reynosa%' Then 'FSD-Reynosa'
  WHEN ship.source3pl= 'Shiphero' And ship.warehouse LIKE 'Tecate%' Then 'FSD-Tecate'
  WHEN ship.source3pl= 'Shiphero' And ship.warehouse LIKE 'Toronto%' Then 'FSD-Hamilton'
